<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        android:layout_marginBottom="2dp"

        app:cardElevation="4dp"
        app:cardCornerRadius="3dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp">

            <ImageView
                android:id="@+id/showMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/guidelineOrderPlaced_v10"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_baseline_more_vert_24" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineOrderPlaced_v10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.10"/>

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineOrderPlaced_v25"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.35"/>

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineOrderPlaced_v85"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.85"/>

            <TextView
                android:id="@+id/cardDispatchDate"
                style="@style/TextAppearance.AppCompat.Body1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="26/10/2021"
                android:textColor="@color/purple_500"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/guidelineOrderPlaced_v25"
                app:layout_constraintStart_toStartOf="@+id/guidelineOrderPlaced_v10"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/cardDispatchClient"
                style="@style/TextAppearance.AppCompat.Body1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Biscocho Alfonso Ugarte #1323"
                android:textColor="@color/purple_500"
                android:textSize="18sp"
                app:layout_constraintEnd_toStartOf="@+id/guidelineOrderPlaced_v85"
                app:layout_constraintStart_toEndOf="@+id/guidelineOrderPlaced_v25"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/cardDispatchDistribution"
                style="@style/TextAppearance.AppCompat.Body2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Estado"
                android:textColor="@color/gray_700"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/guidelineOrderPlaced_v85"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toEndOf="@+id/guidelineOrderPlaced_v25"
                app:layout_constraintTop_toBottomOf="@+id/cardDispatchClient"
                app:layout_constraintVertical_bias="0.0" />

            <TextView
                android:id="@+id/cardDispatchAddress"
                style="@style/TextAppearance.AppCompat.Body2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Address"
                android:textColor="@color/gray_700"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/guidelineOrderPlaced_v85"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toEndOf="@+id/guidelineOrderPlaced_v25"
                app:layout_constraintTop_toBottomOf="@+id/cardDispatchDistribution"
                app:layout_constraintVertical_bias="0.0" />

            <TextView
                android:id="@+id/cardDispatchTotal"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/white_circle_drawable"
                android:backgroundTint="@color/gray_100"
                android:gravity="center"
                android:text="S/ 100.0"
                android:textAlignment="center"
                android:textColor="@color/purple_700"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/guidelineOrderPlaced_v85"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>