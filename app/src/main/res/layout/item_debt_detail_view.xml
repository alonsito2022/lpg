<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="2dp"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="2dp"
    android:background="@color/gray_100">


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_debt_detail_V50"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.35" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_debt_detail_V70"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.6" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_debt_detail_V80"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.8" />


    <TextView
        android:id="@+id/textViewDebtDetailProductName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="BALON DE 10KG MEGA GAS"
        android:textColor="@color/purple_700"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline_debt_detail_V50"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <Button
        android:id="@+id/btnDebtDetailPendingBG"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="12"
        android:layout_margin="2dp"
        android:textColor="@color/white"
        android:backgroundTint="@color/purple_500"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline_debt_detail_V70"
        app:layout_constraintStart_toEndOf="@+id/guideline_debt_detail_V50"
        app:layout_constraintTop_toTopOf="parent" />


    <Button
        android:id="@+id/btnDebtDetailPendingB"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="2"
        android:layout_margin="2dp"
        android:textColor="@color/white"
        android:backgroundTint="@color/purple_500"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline_debt_detail_V80"
        app:layout_constraintStart_toStartOf="@+id/guideline_debt_detail_V70"
        app:layout_constraintTop_toTopOf="parent" />


    <Button
        android:id="@+id/btnDebtDetailPendingG"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="24"
        android:layout_margin="2dp"
        android:textColor="@color/white"
        android:backgroundTint="@color/purple_500"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline_debt_detail_V80"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>